<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <SccProjectName>SAK</SccProjectName>
    <SccLocalPath>SAK</SccLocalPath>
    <SccAuxPath>SAK</SccAuxPath>
    <SccProvider>SAK</SccProvider>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="IronPdf" Version="2026.11.1" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.DotNet.UpgradeAssistant.Extensions.Default.Analyzers" Version="0.4.421302">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="10.0.13" />
    <!-- Do not upgrade: our Spire license key covers versions up to 7.7.10 only.
         7.8.8 and later print an "Evaluation Warning" line on every page. -->
    <PackageReference Include="Spire.PDF" Version="7.7.10" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <!-- Ghostscript for the "custom" print engine (GhostscriptPrinter.cs): the two files it needs are shipped in
       gs\bin next to the exe, so the client PC needs no separate install. Taken from the Ghostscript installed on the
       build machine; if it is missing the app still builds and falls back to Spire (or a GhostscriptPath in config). -->
  <PropertyGroup>
    <GhostscriptDir Condition="'$(GhostscriptDir)' == ''">C:\Program Files\gs\gs10.06.0</GhostscriptDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(GhostscriptDir)\bin\gswin64c.exe')">
    <None Include="$(GhostscriptDir)\bin\gswin64c.exe" Link="gs\bin\gswin64c.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GhostscriptDir)\bin\gsdll64.dll" Link="gs\bin\gsdll64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GhostscriptDir)\doc\COPYING" Link="gs\COPYING.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(GhostscriptDir)\doc\COPYING')" />
  </ItemGroup>
  <Target Name="WarnNoGhostscript" BeforeTargets="Build" Condition="!Exists('$(GhostscriptDir)\bin\gswin64c.exe')">
    <Warning Text="Ghostscript not found at $(GhostscriptDir): the build will not include gs\bin, so the custom print engine needs Ghostscript installed on the client PC." />
  </Target>
  <ItemGroup>
    <!-- License keys, not in git (see .gitignore and Licenses.cs). Copied next to the exe when present. -->
    <None Update="licenses.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
</Project>